<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Keyboard extension (com.mabel.ios.keyboard).
  App Group + open access so the keyboard can use the microphone after
  an explicit tap. No silent listen. No Stiki. No network client.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.mabel.ios</string>
	</array>
</dict>
</plist>
