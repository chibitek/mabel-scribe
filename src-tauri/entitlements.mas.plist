<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  MAS / TestFlight skeleton. Do NOT point the Developer ID DMG path
  (tauri.conf.json + scripts/release-macos.sh) at this file.

  Omitted on purpose (they fail MAS): disable-library-validation and
  allow-unsigned-executable-memory. allow-jit is also omitted; add it back
  only if sandboxed WebKit will not start, with an App Review justification.

  Phase B default (in-process Parakeet / WhisperKit) does not need
  disable-library-validation or allow-unsigned-executable-memory.
  The app is still NOT claimed MAS-ready: WebKit JIT, llama-server,
  sandbox paste, and store signing are unfinished. Do not upload.
  Bundle id stays com.mabel.app. Price: free. Category: Productivity.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.automation.apple-events</key>
    <true/>
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
</dict>
</plist>
