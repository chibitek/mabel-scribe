<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  MAS / TestFlight skeleton. Do NOT point the Developer ID DMG path
  (tauri.conf.json + scripts/release-macos.sh) at this file.

  Omitted on purpose (they fail MAS): disable-library-validation and
  allow-unsigned-executable-memory. allow-jit is also omitted; add it back
  only if sandboxed WebKit will not start, with an App Review justification.

  Phase B default (in-process Parakeet / WhisperKit) does not need
  disable-library-validation or allow-unsigned-executable-memory.
  temporary-exception.apple-events for com.apple.systemevents is required
  so sandboxed paste (osascript → System Events) is not silently blocked.
  CIO must keep device.audio-input on the signed TF binary — dropping it
  makes TCC deny the mic with no prompt and a silent capture.
  Bundle id stays com.mabel.app. Price: free. Category: Productivity.

  In-App Purchase is an App ID + provisioning-profile capability for
  com.mabel.app / ASC 6809059582, not a sandbox entitlement key.
  Do not add com.apple.developer.in-app-payments (Apple Pay merchants).
  CIO/CoS must enable In-App Purchase on the App ID before MAS/TF StoreKit
  works. Developer ID DMG keeps entitlements.plist unchanged.
  home-relative-path.read-only is for copy-if-missing import of prior
  DMG / productName / Typr Application Support into the TF container.
  Do not drop device.audio-input or the System Events AE exception (#10).
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.automation.apple-events</key>
    <true/>
    <key>com.apple.security.temporary-exception.apple-events</key>
    <array>
        <string>com.apple.systemevents</string>
    </array>
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
    <array>
        <string>/Library/Application Support/com.mabel.app</string>
        <string>/Library/Application Support/com.typr.app</string>
        <string>/Library/Application Support/Mabel</string>
        <string>/Library/Application Support/Typr</string>
        <string>/Library/Application Support/typr</string>
        <string>/Library/Containers/com.typr.app/Data/Library/Application Support/com.typr.app</string>
        <string>/Library/Containers/com.mabel.app/Data/Library/Application Support/Mabel</string>
    </array>
</dict>
</plist>
