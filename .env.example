# Local / CI only. Copy to `.env` if you want a dotenv file.
# `.env` and `.env.*` are gitignored. Never commit real values.

# Optional Groq cloud engine (otherwise use the in-app Keychain field).
# MABEL_GROQ_KEY=

# Official DMG release (scripts/release-macos.sh). Required for that script.
# MABEL_SIGNING_IDENTITY=Developer ID Application: Your Name (TEAMID)
# MABEL_NOTARY_PROFILE=AC_PASSWORD
# MABEL_TAURI_CONFIG=src-tauri/tauri.local.conf.json
# TAURI_SIGNING_PRIVATE_KEY_PATH=
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# Ad-hoc notarized `tauri build` (see README). Prefer a keychain profile.
# APPLE_ID=your-apple-id@example.com
# APPLE_PASSWORD=xxxx-xxxx-xxxx-xxxx
# APPLE_TEAM_ID=TEAMID
