# Rust
target/

# In-process CoreML ASR products (built on macOS by scripts/build-mabel-asr.sh)
src-tauri/native-asr/*
!src-tauri/native-asr/.gitkeep
native/MabelASR/.build/

# StoreKit 2 dylib (built on macOS by scripts/build-mabel-storekit.sh)
src-tauri/native-storekit/*
!src-tauri/native-storekit/.gitkeep
native/MabelStoreKit/.build/
tools/MabelStoreKitProve/MabelStoreKitProve.xcodeproj/xcuserdata/
tools/MabelStoreKitProve/MabelStoreKitProve.xcodeproj/project.xcworkspace/

# Native visionOS sibling (Mabel Spatial) — local Xcode noise only
MabelSpatial/MabelSpatial.xcodeproj/xcuserdata/
MabelSpatial/MabelSpatial.xcodeproj/project.xcworkspace/xcuserdata/
MabelSpatial/DerivedData/

# Native iOS sibling (Mabel keyboard) — local Xcode noise only
MabelIOS/MabelIOS.xcodeproj/xcuserdata/
MabelIOS/MabelIOS.xcodeproj/project.xcworkspace/xcuserdata/
MabelIOS/DerivedData/

